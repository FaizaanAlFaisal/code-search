# Copy to .env and adjust. Loaded automatically from the repo root on every run
# (config calls load_dotenv; an explicitly-set environment variable still wins).
# Every value below is optional; shown values are the built-in defaults.

# ── Storage ──
# SQLite index location (created on first run; relative to the cwd you run from).
CODE_SEARCH_DB_PATH=storage/code-search/code-search.db

# ── Services (HTTP) ──
CODE_SEARCH_QDRANT_URL=http://127.0.0.1:6333
CODE_SEARCH_OLLAMA_URL=http://127.0.0.1:11434

# ── Models (must be pulled in Ollama) ──
CODE_SEARCH_EMBED_MODEL=qwen3-embedding:4b
CODE_SEARCH_SUMMARY_MODEL=qwen3.5:4b
CODE_SEARCH_EMBED_MODEL_CTX=8192
CODE_SEARCH_SUMMARY_MODEL_CTX=8192
CODE_SEARCH_SUMMARY_MODEL_THINK=false

# ── GPU / runtime ──
# num_gpu: 99 = pin all layers to GPU, -1 = let Ollama auto-decide, 0 = CPU only.
CODE_SEARCH_NUM_GPU=99
CODE_SEARCH_SUMMARY_TIMEOUT=300
CODE_SEARCH_EMBED_TIMEOUT=120
# Keep the embed model warm (search hot path); let the reasoning model idle out.
CODE_SEARCH_EMBED_KEEP_ALIVE=24h
CODE_SEARCH_SUMMARY_KEEP_ALIVE=5m

# ── Indexing ──
CODE_SEARCH_MAX_FILE_BYTES=524288
# Honor .gitignore even outside a git repo (like ripgrep).
CODE_SEARCH_RESPECT_GITIGNORE=true

# ── Embeddings / batching ──
# Texts per Ollama embed call + per Qdrant bulk upsert. Gains saturate ~16-32 on
# small GPUs; bigger just costs VRAM. 0 in NUM_BATCH = use Ollama's default.
CODE_SEARCH_EMBED_BATCH=32
# llama.cpp num_batch (tokens per GPU forward pass). Raising costs VRAM; only
# helps if the GPU isn't already saturated. Watch `ollama ps` if you raise it.
CODE_SEARCH_EMBED_NUM_BATCH=0

# ── Progress / checkpointing ──
# Commit model batches every N jobs (live progress + interrupt-safe).
CODE_SEARCH_COMMIT_EVERY=50
# Set to false to silence the stderr progress line.
CODE_SEARCH_PROGRESS=true

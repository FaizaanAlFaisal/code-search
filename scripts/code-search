#!/usr/bin/env bash
# Public retrieval CLI: explore / find / search / open / refresh.
# Relocatable — resolves the repo root from this script's location.
set -euo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
if [ -n "${CODE_SEARCH_PYTHON:-}" ]; then
  PY="$CODE_SEARCH_PYTHON"
elif [ -x "$HERE/.venv/bin/python" ]; then
  PY="$HERE/.venv/bin/python"
else
  PY="$(command -v python3)"
fi
[ -f "$HERE/.env" ] && set -a && . "$HERE/.env" && set +a
export PYTHONPATH="$HERE${PYTHONPATH:+:$PYTHONPATH}"
exec "$PY" "$HERE/code_search_tool/cli.py" "$@"

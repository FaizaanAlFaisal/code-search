# Copy to .env and adjust. Loaded automatically from the repo root on every run
# (config calls load_dotenv; an explicitly-set environment variable still wins).
# Every value below is optional; shown values are the built-in defaults.

# ── Storage ──
# SQLite index location (created on first run; relative to the cwd you run from).
CODE_SEARCH_DB_PATH=storage/code-search/code-search.db

# ── Services (HTTP) ──
CODE_SEARCH_QDRANT_URL=http://127.0.0.1:6333
CODE_SEARCH_OLLAMA_URL=http://127.0.0.1:11434

# ── Models (must be pulled in Ollama) ──
CODE_SEARCH_EMBED_MODEL=qwen3-embedding:4b
CODE_SEARCH_EMBED_MODEL_CTX=8192

# ── GPU / runtime ──
# num_gpu: 99 = pin all layers to GPU, -1 = let Ollama auto-decide, 0 = CPU only.
CODE_SEARCH_NUM_GPU=99
CODE_SEARCH_EMBED_TIMEOUT=120
# Keep the embed model warm; it sits on the search hot path.
CODE_SEARCH_EMBED_KEEP_ALIVE=24h

# ── Indexing ──
CODE_SEARCH_MAX_FILE_BYTES=524288
# Honor .gitignore even outside a git repo (like ripgrep).
CODE_SEARCH_RESPECT_GITIGNORE=true
